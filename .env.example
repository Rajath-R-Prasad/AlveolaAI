# ==============================================================================
# AlveolaAI Environment Variables Configuration (EC2 VPS Deployment)
# ==============================================================================

# --- Ports ---
FRONTEND_PORT=80
BACKEND_PORT=8000

# --- Backend Configuration ---
MODEL_PATH=models/best_model.onnx
CONFIDENCE_THRESHOLD=0.45
MAX_FILE_SIZE_MB=10

# --- Frontend Configuration ---
# Leave VITE_API_BASE_URL empty when using Nginx reverse proxy on port 80
VITE_API_BASE_URL=
VITE_GEMINI_API_KEY=your_gemini_api_key_here
